# =============================================================================
# ZoneTec — PRODUCTION environment template
# =============================================================================
# Copy to `.env` ON THE SERVER ONLY. Never commit the filled-in version.
# Every `CHANGE_ME` must be replaced before the site is reachable publicly.
#
# Values marked [KEEP] must be copied verbatim from the current local .env,
# otherwise existing encrypted data (stored payment credentials, sessions)
# becomes unreadable.
# =============================================================================

APP_NAME=ZoneTec
APP_ENV=production
# [KEEP] Copy APP_KEY from the local .env. Generating a new one invalidates
# every encrypted value already in the database.
APP_KEY=CHANGE_ME
APP_DEBUG=false
APP_DEBUG_ALLOWED_IPS=
APP_URL=https://CHANGE_ME.example.com
# Do not leave this as "admin" — it is the single biggest source of brute-force
# login traffic on a public Bagisto install. Use something unguessable.
APP_ADMIN_URL=CHANGE_ME
# TODO: set to the store's operating timezone (e.g. Asia/Dubai, Asia/Beirut).
# The Bagisto default of Asia/Kolkata will skew every order timestamp + report.
APP_TIMEZONE=CHANGE_ME

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_CURRENCY=USD

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
# Rotate logs instead of one ever-growing file (the local one is already 575 KB).
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=CHANGE_ME
# Use a dedicated least-privilege user, never root.
DB_USERNAME=CHANGE_ME
DB_PASSWORD=CHANGE_ME
DB_PREFIX=

SESSION_DRIVER=database
SESSION_LIFETIME=120
# Requires HTTPS; encrypts the session payload at rest.
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
# `sync` runs order mails, exports and image processing inside the web request.
# `database` requires a running worker: php artisan queue:work --tries=3
QUEUE_CONNECTION=database

CACHE_STORE=file
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Full-page response cache. Large win on catalog pages; flush after content edits.
RESPONSE_CACHE_ENABLED=true

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=CHANGE_ME
# Rotate the Brevo SMTP key before launch — the development one has been shared.
MAIL_PASSWORD=CHANGE_ME
# Must be an address on the store's own domain with SPF + DKIM configured in
# DNS. A gmail.com sender routed through Brevo fails alignment and lands in spam.
MAIL_FROM_ADDRESS=no-reply@CHANGE_ME.example.com
MAIL_FROM_NAME="ZoneTec"

ADMIN_MAIL_ADDRESS=admin@CHANGE_ME.example.com
ADMIN_MAIL_NAME="ZoneTec Admin"

CONTACT_MAIL_ADDRESS=contact@CHANGE_ME.example.com
CONTACT_MAIL_NAME="ZoneTec Contact"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Build-time only. Assets are compiled ahead of deploy, so the dev server
# host/port are irrelevant in production.
VITE_APP_NAME="${APP_NAME}"
VITE_HOST=localhost
VITE_PORT=
